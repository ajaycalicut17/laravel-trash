{
    "name": "ajaycalicut17/laravel-trash",
    "description": "Laravel package to manage soft delete.",
    "keywords": [
        "ajaycalicut17",
        "laravel-trash",
        "laravel",
        "soft-delete",
        "eloquent",
        "model",
        "trash",
        "delete",
        "restore"
    ],
    "homepage": "https://github.com/ajaycalicut17/laravel-trash",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ajay A",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "nunomaduro/larastan": "^3.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ajaycalicut17\\LaravelTrash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ajaycalicut17\\LaravelTrash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ajaycalicut17\\LaravelTrash\\LaravelTrashServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
